# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
!.env.example

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Databases & local sqlite files (allow schema & seed)
*.sqlite3
*.db
*.db-journal

# ML models cache
services/models_cache/*.joblib
services/models_cache/*.pkl

# Generated reports & exports (preserve folder structure via .gitkeep)
reports/*.pdf
data/raw/*.csv
data/processed/*.csv
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep
!reports/.gitkeep

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/
