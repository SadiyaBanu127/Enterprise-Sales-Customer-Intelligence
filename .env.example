# ==========================================
# Enterprise Sales & Customer Intelligence
# Environment Configuration
# ==========================================

# Flask Environment
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=enterprise_super_secret_sales_intelligence_key_2026

# Database Configuration (MySQL / SQLAlchemy)
# Default MySQL connection:
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sales_intelligence_db

# Full Database URL (If set, overrides individual DB parameters)
# MySQL Example: mysql+pymysql://root:root@localhost:3306/sales_intelligence_db
# SQLite Fallback Example: sqlite:///data/sales_intelligence.db
DATABASE_URL=sqlite:///data/sales_intelligence.db

# Machine Learning & Analytics Settings
ML_MODEL_DIR=services/models_cache
FORECAST_HORIZON_DAYS=180
CHURN_THRESHOLD=0.5

# Security & Session Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME=86400
